<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mail_template_hr_payslip" model="mail.template">
            <field name="name">HR Payslip Email</field>
            <field name="model_id" ref="jm_hr_payroll.model_hr_payslip"/>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="subject">Payslip for {{ object.employee_id.name }} - {{ object.date_from }} to {{ object.date_to }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;">
                    <p>Dear <t t-out="object.employee_id.name or ''"/>,</p>
                    <p>Please find attached your payslip for the period
                        <strong><t t-out="object.date_from"/> - <t t-out="object.date_to"/></strong>.
                    </p>
                    <p>If you have any questions or require clarification, please contact the HR or Accounts department.</p>
                    <br/>
                    <p>Best Regards,</p>
                    <p><t t-out="user.name"/></p>
                </div>
            </field>
            <field name="report_template" ref="jm_hr_payroll.payslip_details_report"/>
            <field name="report_name">{{ (object.number or 'Payslip').replace('/','_') }}</field>
        </record>
    </data>
</odoo>
